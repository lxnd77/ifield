# ============================================================
# Copy to `.env` and fill in. `.env` is gitignored.
# ============================================================

# ── Google Analytics 4 ──
# The Measurement ID from GA4 Admin → Data Streams → Web (format: G-XXXXXXXXXX).
# Leave BLANK to disable analytics entirely — with no ID set, gtag.js is never
# loaded and the consent banner's analytics toggle has nothing to enable.
# Note this is a PUBLIC_ variable: it ships to the browser, which is correct
# for GA, and it is not a secret.
PUBLIC_GA_MEASUREMENT_ID=

# ── Contact form + newsletter notifications ──
# See README-EMAIL.md for the Resend domain-verification steps this
# depends on. Without RESEND_API_KEY set, both /api/contact and
# /api/newsletter return the site's honest failure state — nothing
# throws, nothing is silently dropped.
#
# Resend API key — server-side only, never prefix with PUBLIC_.
RESEND_API_KEY=
# Verified sending address on the ifield.ae domain.
CONTACT_FROM_EMAIL=website@ifield.ae
# Where enquiries and newsletter sign-up notifications are delivered.
CONTACT_TO_EMAIL=info@ifield.ae
