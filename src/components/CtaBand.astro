---
/**
 * CtaBand — the red closing band on every inner page.
 * Centred, max 860px, eyebrow + heading + italic subtitle + two actions.
 */
interface Action {
  readonly label: string;
  readonly href: string;
  /** Outlined rather than filled. */
  readonly ghost?: boolean;
}

interface Props {
  eyebrow?: string;
  /** HTML, so `<em>` emphasis works. */
  title: string;
  subtitle?: string;
  actions?: readonly Action[];
}

const { eyebrow = 'Get in Touch', title, subtitle, actions = [] } = Astro.props;
---

<section class="cta">
  <div class="cta__inner reveal">
    <span class="eyebrow eyebrow--light">{eyebrow}</span>
    <h2 class="section-h2 section-h2--light" set:html={title} />
    {subtitle && <span class="section-h2-sub cta__sub">{subtitle}</span>}
    {
      actions.length > 0 && (
        <div class="cta__actions">
          {actions.map((a) => (
            <a
              href={a.href}
              class:list={['btn-on-accent', { 'btn-on-accent--ghost': a.ghost }]}
            >
              {a.label}
            </a>
          ))}
        </div>
      )
    }
  </div>
</section>

<style>
  .cta {
    background: var(--accent);
    color: var(--on-dark);
    padding: clamp(72px, 10vw, 116px) clamp(24px, 5vw, 64px);
  }

  .cta__inner {
    max-width: 860px;
    margin: 0 auto;
    text-align: center;
  }

  .cta__sub {
    color: rgba(250, 248, 244, 0.85);
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: center;
    margin-top: 40px;
  }
</style>
