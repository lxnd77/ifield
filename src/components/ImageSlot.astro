---
/**
 * ImageSlot — renders a manifest image, or the design's diagonal-hatch
 * placeholder when the file has not been supplied yet.
 *
 * The hatch pattern is lifted from the original prototypes, which used
 * exactly this treatment for unshot photography. The slot name is printed
 * on the placeholder so a missing image is obvious on the page and the
 * filename to supply is never in doubt.
 */
import { resolveImage } from '../lib/assets';
import { ratioToCss, type ImageKey } from '../data/images';

interface Props {
  /** Manifest key from src/data/images.ts */
  slot: ImageKey;
  /** Override the manifest's default alt text. */
  alt?: string;
  /** Extra classes on the wrapper. */
  class?: string;
  /**
   * Resting CSS filter for the image, e.g. 'grayscale(100%)'.
   *
   * Applied as `--imgslot-filter-default`. Any ancestor may override it
   * by setting `--imgslot-filter` (typically on hover) — the image reads
   * the override first and falls back to this default, so parents never
   * need `!important` to beat an inline style.
   */
  filter?: string;
  /** Override the wrapper's aspect-ratio, e.g. for fixed-height rows. */
  ratio?: string;
  /** Fill the parent instead of establishing its own aspect-ratio box. */
  fill?: boolean;
  /** Native loading strategy. Heroes should pass 'eager'. */
  loading?: 'lazy' | 'eager';
  /** Native decoding hint. */
  fetchpriority?: 'high' | 'low' | 'auto';
  /** Caption shown bottom-left over the image (capability + process rows). */
  caption?: string;
}

const {
  slot,
  alt,
  class: className = '',
  filter,
  ratio,
  fill = false,
  loading = 'lazy',
  fetchpriority,
  caption,
} = Astro.props;

const resolved = resolveImage(slot);
const altText = alt ?? resolved.slot.alt;
const boxRatio = fill ? undefined : (ratio ?? ratioToCss(resolved.slot.ratio));

const wrapperStyle = [
  boxRatio ? `--imgslot-ratio:${boxRatio}` : null,
  filter ? `--imgslot-filter-default:${filter}` : null,
]
  .filter(Boolean)
  .join(';');
---

<div
  class:list={['imgslot', { 'imgslot--fill': fill, 'imgslot--empty': !resolved.available }, className]}
  style={wrapperStyle || undefined}
  data-slot={slot}
>
  {
    resolved.available ? (
      <img
        src={resolved.src}
        alt={altText}
        loading={loading}
        decoding="async"
        fetchpriority={fetchpriority}
      />
    ) : (
      <span class="imgslot__label" aria-hidden="true">
        <span class="imgslot__name">{slot}</span>
        <span class="imgslot__meta">
          {resolved.slot.ratio} · {resolved.slot.minWidth}px min
        </span>
        <span class="imgslot__path">public/{resolved.slot.path}</span>
      </span>
    )
  }
  {caption && <span class="imgslot__caption">{caption}</span>}
</div>

<style>
  .imgslot {
    position: relative;
    overflow: hidden;
    aspect-ratio: var(--imgslot-ratio);
    /* The hatch pattern the prototypes used for unshot photography */
    background-image: repeating-linear-gradient(
      135deg,
      #e7e3da 0px,
      #e7e3da 1px,
      #f3f1ea 1px,
      #f3f1ea 13px
    );
    border: 1px solid var(--border);
  }

  .imgslot--fill {
    position: absolute;
    inset: 0;
    aspect-ratio: auto;
    border: none;
  }

  .imgslot img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: var(--imgslot-filter, var(--imgslot-filter-default, none));
  }

  /* ── Placeholder label ── */
  .imgslot__label {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 16px;
    text-align: center;
  }

  .imgslot__name {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(26, 22, 20, 0.55);
  }

  .imgslot__meta {
    font-family: var(--ff-body);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(26, 22, 20, 0.38);
  }

  .imgslot__path {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 10px;
    color: rgba(139, 26, 26, 0.6);
    word-break: break-all;
  }

  /* Dark placeholder where the slot sits on a dark band */
  .imgslot--on-dark {
    background-image: repeating-linear-gradient(
      135deg,
      #2a2622 0px,
      #2a2622 1px,
      #1f1b18 1px,
      #1f1b18 13px
    );
    border-color: rgba(250, 248, 244, 0.1);
  }

  .imgslot--on-dark .imgslot__name {
    color: rgba(250, 248, 244, 0.6);
  }

  .imgslot--on-dark .imgslot__meta {
    color: rgba(250, 248, 244, 0.35);
  }

  .imgslot--on-dark .imgslot__path {
    color: rgba(255, 255, 255, 0.35);
  }

  /* ── Caption (capability + process rows) ── */
  .imgslot__caption {
    position: absolute;
    left: 18px;
    bottom: 16px;
    z-index: 2;
    font-family: var(--ff-body);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.92);
  }

  .imgslot--empty .imgslot__caption {
    color: rgba(26, 22, 20, 0.5);
  }
</style>
