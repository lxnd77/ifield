---
/**
 * Nav — fixed header, shared by every page.
 *
 * Transparent over the dark hero, then at scrollY > 60 it becomes an
 * opaque cream bar: logo swaps white → dark, links flip to the dark
 * palette, hamburger bars invert. The active page's link is accent
 * coloured with a 2px rule 9px below it.
 *
 * Pass `solid` on any page that does not open with a dark hero, so the
 * bar starts in its opaque state rather than rendering white-on-cream.
 */
import { navLinks, navCta, site } from '../data/site';
import { images } from '../data/images';

interface Props {
  /** Force the scrolled/opaque appearance from the top of the page. */
  solid?: boolean;
}

const { solid = false } = Astro.props;

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (match: string) => path === match || path.startsWith(`${match}/`);
---

<nav class:list={['nav', { 'is-solid': solid }]} id="mainNav" data-solid={solid ? '' : undefined}>
  <div class="nav-inner">
    <a href="/" class="nav-logo" aria-label={`${site.name} — home`}>
      <img class="logo-white" src={`/${images.logoWhite.path}`} alt={site.name} width="140" height="38" />
      <img class="logo-dark" src={`/${images.logoDark.path}`} alt="" aria-hidden="true" width="140" height="38" />
    </a>

    <ul class="nav-links">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={['nav-link', { 'is-active': isActive(link.match) }]}
              aria-current={isActive(link.match) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li><a href={navCta.href} class="nav-cta">{navCta.label}</a></li>
    </ul>

    <button
      class="nav-hamburger"
      id="navHamburger"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobileNav"
    >
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<div class="mobile-nav" id="mobileNav" inert>
  <button class="mobile-nav-close" id="mobileNavClose" type="button" aria-label="Close menu">
    &times;
  </button>
  {
    navLinks.map((link) => (
      <a href={link.href} aria-current={isActive(link.match) ? 'page' : undefined}>
        {link.label}
      </a>
    ))
  }
  <a href={navCta.href} class="mobile-nav-cta">{navCta.label}</a>
</div>

<script>
  const nav = document.getElementById('mainNav');
  const hamburger = document.getElementById('navHamburger');
  const mobileNav = document.getElementById('mobileNav');
  const closeBtn = document.getElementById('mobileNavClose');

  // ── Scrolled state ──
  if (nav && !nav.hasAttribute('data-solid')) {
    const sync = () => nav.classList.toggle('is-scrolled', window.scrollY > 60);
    window.addEventListener('scroll', sync, { passive: true });
    sync();
  }

  // ── Mobile drawer ──
  if (hamburger && mobileNav && closeBtn) {
    let lastFocused: HTMLElement | null = null;
    let inertTimer: number | undefined;

    /** Matches the .mobile-nav transform transition. */
    const SLIDE_MS = 400;

    const open = () => {
      window.clearTimeout(inertTimer);
      lastFocused = document.activeElement as HTMLElement | null;
      mobileNav.removeAttribute('inert');
      mobileNav.classList.add('is-open');
      hamburger.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      closeBtn.focus();
    };

    const close = () => {
      mobileNav.classList.remove('is-open');
      hamburger.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      lastFocused?.focus();

      // Re-assert `inert` once the panel is off-screen, so focus cannot
      // land inside mid-slide. A plain `transitionend` listener is not
      // enough — it never fires if the transition is interrupted (rapid
      // toggling) or if frames are not being produced, which would leave
      // invisible links in the tab order.
      window.clearTimeout(inertTimer);
      inertTimer = window.setTimeout(() => {
        if (!mobileNav.classList.contains('is-open')) mobileNav.setAttribute('inert', '');
      }, SLIDE_MS);
    };

    hamburger.addEventListener('click', open);
    closeBtn.addEventListener('click', close);
    mobileNav.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && mobileNav.classList.contains('is-open')) close();
    });

    // Leaving mobile width with the drawer open would strand the scroll lock.
    const mq = window.matchMedia('(min-width: 901px)');
    mq.addEventListener('change', (e) => {
      if (e.matches && mobileNav.classList.contains('is-open')) close();
    });
  }
</script>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: var(--nav-h);
    transition:
      background 0.35s var(--ease-out),
      box-shadow 0.35s;
  }

  .nav.is-scrolled,
  .nav.is-solid {
    background: rgba(250, 248, 244, 0.96);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    box-shadow: 0 1px 0 var(--border);
  }

  .nav-inner {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 48px;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* ── Logo ── */
  .nav-logo {
    display: flex;
    align-items: center;
  }

  .nav-logo img {
    height: 38px;
    width: auto;
    display: block;
  }

  .nav-logo .logo-dark {
    display: none;
  }

  .nav.is-scrolled .nav-logo .logo-white,
  .nav.is-solid .nav-logo .logo-white {
    display: none;
  }

  .nav.is-scrolled .nav-logo .logo-dark,
  .nav.is-solid .nav-logo .logo-dark {
    display: block;
  }

  /* ── Links ── */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 36px;
    list-style: none;
  }

  .nav-link {
    position: relative;
    font-family: var(--ff-body);
    font-size: var(--t-xs);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--nav-link);
    transition:
      color 0.2s,
      font-weight 0.2s;
  }

  .nav-link:hover {
    color: #fff;
  }

  .nav-link.is-active {
    color: #fff;
  }

  .nav-link.is-active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -9px;
    height: 2px;
    background: var(--accent);
    border-radius: 1px;
  }

  .nav.is-scrolled .nav-link,
  .nav.is-solid .nav-link {
    color: var(--text-secondary);
  }

  .nav.is-scrolled .nav-link:hover,
  .nav.is-solid .nav-link:hover {
    color: var(--text-primary);
  }

  .nav.is-scrolled .nav-link.is-active,
  .nav.is-solid .nav-link.is-active {
    color: var(--accent);
    font-weight: 600;
  }

  .nav-cta {
    padding: 10px 22px;
    background: var(--accent);
    color: #fff;
    border-radius: 2px;
    font-family: var(--ff-body);
    font-size: var(--t-xs);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: background 0.2s;
  }

  .nav-cta:hover {
    background: var(--accent-hover);
  }

  /* ── Hamburger ── */
  .nav-hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: 8px;
  }

  .nav-hamburger span {
    display: block;
    width: 24px;
    height: 1.5px;
    background: #fff;
    transition: background 0.3s;
  }

  .nav.is-scrolled .nav-hamburger span,
  .nav.is-solid .nav-hamburger span {
    background: var(--text-primary);
  }

  /* ── Mobile drawer ── */
  .mobile-nav {
    position: fixed;
    inset: 0;
    background: var(--bg-dark);
    z-index: 200;
    display: flex;
    flex-direction: column;
    padding: 80px 24px 48px;
    transform: translateX(100%);
    transition: transform 0.4s var(--ease-out);
    overflow-y: auto;
  }

  .mobile-nav.is-open {
    transform: translateX(0);
  }

  .mobile-nav-close {
    position: absolute;
    top: 20px;
    right: 24px;
    font-size: 28px;
    color: #fff;
    line-height: 1;
  }

  .mobile-nav a {
    font-family: var(--ff-display);
    font-size: 28px;
    color: #fff;
    padding: 16px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    display: block;
  }

  .mobile-nav a[aria-current='page'] {
    color: var(--accent);
  }

  .mobile-nav a:last-of-type {
    border-bottom: none;
  }

  .mobile-nav-cta {
    margin-top: 32px;
    padding: 16px;
    background: var(--accent);
    color: #fff !important;
    text-align: center;
    font-family: var(--ff-body);
    font-size: var(--t-sm);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-radius: 2px;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .nav-inner {
      padding: 0 24px;
    }

    .nav-links {
      display: none;
    }

    .nav-hamburger {
      display: flex;
    }
  }

  @media (max-width: 600px) {
    .nav-inner {
      padding: 0 20px;
    }
  }
</style>
