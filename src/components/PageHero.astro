---
/**
 * PageHero — the dark full-bleed hero shared by every inner page.
 *
 * Background photo at grayscale(100%) brightness(0.40) with a slow
 * ken-burns drift, a three-stop gradient for text legibility, and the
 * arch element floating top-right. Content is bottom-aligned.
 *
 * Two footer strip variants, both from the prototypes:
 *   facts — uppercase micro-labels (Capabilities, Process, Company)
 *   stats — big Playfair figure over a label (Projects)
 */
import ImageSlot from './ImageSlot.astro';
import { images, type ImageKey } from '../data/images';
import { resolveImage } from '../lib/assets';

export interface HeroStat {
  readonly value: string;
  readonly label: string;
}

interface Props {
  eyebrow: string;
  /** Rendered as HTML so `<em>` emphasis works, matching the designs. */
  title: string;
  lead?: string;
  image: ImageKey;
  /** Uppercase micro-labels along the bottom rule. */
  facts?: readonly string[];
  /** Figure + label pairs along the bottom rule. Overrides `facts`. */
  stats?: readonly HeroStat[];
  /** Viewport height. The designs use 78vh, 80vh (Company), 66vh (Journal). */
  minHeight?: string;
  /** Character cap on the h1 measure. */
  titleWidth?: string;
}

const {
  eyebrow,
  title,
  lead,
  image,
  facts,
  stats,
  minHeight = '78vh',
  titleWidth = '18ch',
} = Astro.props;

const hero = resolveImage(image);
---

<section class="hero" id="top" style={`--hero-min-h:${minHeight}`}>
  <div class="hero__media">
    {
      hero.available ? (
        <img src={hero.src} alt="" fetchpriority="high" decoding="async" />
      ) : (
        <ImageSlot slot={image} fill class="imgslot--on-dark" />
      )
    }
  </div>

  <div class="hero__scrim" aria-hidden="true"></div>

  <img
    class="hero__element"
    src={`/${images.element01.path}`}
    alt=""
    aria-hidden="true"
    loading="lazy"
  />

  <div class="container hero__inner">
    <p class="hero__eyebrow">{eyebrow}</p>
    <h1 class="hero__title" style={`--hero-title-w:${titleWidth}`} set:html={title} />
    {lead && <p class="hero__lead">{lead}</p>}

    {
      stats ? (
        <div class="hero__strip">
          {stats.map((s) => (
            <div class="hero__stat">
              <span class="hero__statValue">{s.value}</span>
              <span class="hero__statLabel">{s.label}</span>
            </div>
          ))}
        </div>
      ) : (
        facts && (
          <div class="hero__strip">
            {facts.map((f) => (
              <span class="hero__fact">{f}</span>
            ))}
          </div>
        )
      )
    }
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: var(--hero-min-h, 78vh);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    background: var(--bg-dark);
    overflow: hidden;
    padding: 148px 0 92px;
  }

  .hero__media {
    position: absolute;
    inset: 0;
  }

  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%) brightness(0.4);
    animation: kenburns 18s ease-in-out infinite alternate;
    transform-origin: center;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(17, 16, 9, 0.55) 0%,
      rgba(17, 16, 9, 0.25) 40%,
      rgba(17, 16, 9, 0.92) 100%
    );
  }

  .hero__element {
    position: absolute;
    top: -60px;
    right: -80px;
    width: 420px;
    opacity: 0.1;
    filter: invert(1);
    pointer-events: none;
    animation: floatdrift 14s ease-in-out infinite;
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    width: 100%;
  }

  .hero__eyebrow {
    font-family: var(--ff-body);
    font-size: var(--t-eyebrow);
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    margin-bottom: 22px;
  }

  .hero__title {
    font-family: var(--ff-display);
    font-weight: 400;
    font-size: var(--t-h1);
    line-height: 1.04;
    color: #fff;
    max-width: var(--hero-title-w, 18ch);
  }

  .hero__title :global(em) {
    font-style: italic;
    color: rgba(255, 255, 255, 0.6);
  }

  .hero__lead {
    font-family: var(--ff-body);
    font-weight: 300;
    margin-top: 26px;
    font-size: clamp(17px, 1.5vw, 20px);
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.72);
    max-width: 62ch;
  }

  .hero__strip {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(20px, 4vw, 56px);
    margin-top: 46px;
    padding-top: 28px;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
  }

  .hero__fact {
    font-family: var(--ff-body);
    font-size: var(--t-xs);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.62);
  }

  .hero__statValue {
    font-family: var(--ff-display);
    font-size: clamp(30px, 3.4vw, 44px);
    color: #fff;
    display: block;
    line-height: 1;
  }

  .hero__statLabel {
    font-family: var(--ff-body);
    font-size: var(--t-xs);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
  }

  @media (max-width: 600px) {
    .hero {
      padding: 128px 0 72px;
    }

    .hero__element {
      width: 280px;
      right: -100px;
    }
  }
</style>
