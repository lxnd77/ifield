---
/**
 * JourneyTimeline — "Our Journey" as a horizontally scrollable rail of
 * milestone cards with scroll-snap and drag-to-scroll.
 *
 * The design offered a vertical-rail alternative behind a prop; the
 * horizontal scroll is the default and the one built here.
 */
import ImageSlot from "../ImageSlot.astro";
import { milestones } from "../../data/team";
---

<section class="journey">
  <div class="container">
    <div class="journey__head reveal">
      <span class="eyebrow journey__eyebrow">Our Journey</span>
      <h2 class="section-h2">The Road To a Global Standard.</h2>
      <span class="section-h2-sub"
        >A reputation built one project at a time</span
      >
    </div>

    <div
      class="journey__scroller"
      id="journeyScroller"
      tabindex="0"
      aria-label="Company milestones, scrollable"
    >
      <ol class="journey__track">
        {
          milestones.map((m) => (
            <li class="milestone">
              <div class="milestone__media">
                <ImageSlot slot={m.image} alt="" fill filter="grayscale(30%)" />
              </div>
              <div class="milestone__body">
                <div class="milestone__when">
                  <span class="milestone__year">{m.year}</span>
                  <span class="milestone__month">{m.month}</span>
                </div>
                <h3 class="milestone__title">{m.title}</h3>
                <p class="body-text milestone__text">{m.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <p class="journey__hint">Drag or scroll to explore →</p>
  </div>
</section>

<script>
  const scroller = document.getElementById("journeyScroller");

  if (scroller) {
    let dragging = false;
    let startX = 0;
    let startScroll = 0;
    let moved = 0;

    scroller.addEventListener("pointerdown", (event) => {
      if (event.button !== 0 || event.pointerType !== "mouse") return;
      dragging = true;
      moved = 0;
      startX = event.clientX;
      startScroll = scroller.scrollLeft;
      scroller.classList.add("is-dragging");
    });

    window.addEventListener("pointermove", (event) => {
      if (!dragging) return;
      const dx = event.clientX - startX;
      moved = Math.abs(dx);
      scroller.scrollLeft = startScroll - dx;
    });

    const end = () => {
      if (!dragging) return;
      dragging = false;
      scroller.classList.remove("is-dragging");
    };

    window.addEventListener("pointerup", end);
    window.addEventListener("pointercancel", end);

    // Never let the end of a drag register as a click on a card.
    scroller.addEventListener(
      "click",
      (event) => {
        if (moved > 6) {
          event.preventDefault();
          event.stopPropagation();
        }
      },
      true,
    );
  }
</script>

<style>
  .journey {
    background: var(--bg-warm);
    padding: clamp(72px, 10vw, 120px) 0;
  }

  .journey__head {
    text-align: center;
    max-width: 760px;
    margin: 0 auto;
  }

  .journey__eyebrow {
    width: fit-content;
    margin-left: auto;
    margin-right: auto;
  }

  .journey__scroller {
    margin-top: clamp(40px, 5vw, 60px);
    overflow-x: auto;
    padding: 6px 4px 26px;
    scroll-snap-type: x mandatory;
    cursor: grab;
    scrollbar-width: thin;
    scrollbar-color: rgba(26, 22, 20, 0.25) transparent;
  }

  .journey__scroller.is-dragging {
    cursor: grabbing;
    user-select: none;
    scroll-snap-type: none;
    scroll-behavior: auto;
  }

  .journey__scroller::-webkit-scrollbar {
    height: 6px;
  }

  .journey__scroller::-webkit-scrollbar-thumb {
    background: rgba(26, 22, 20, 0.22);
    border-radius: 3px;
  }

  .journey__scroller::-webkit-scrollbar-track {
    background: transparent;
  }

  .journey__track {
    display: flex;
    gap: 26px;
    width: max-content;
    list-style: none;
  }

  .milestone {
    scroll-snap-align: start;
    min-width: 336px;
    max-width: 336px;
    background: var(--bg-cream);
    border: 1px solid rgba(26, 22, 20, 0.08);
  }

  .milestone__media {
    position: relative;
    height: 172px;
    overflow: hidden;
  }

  .milestone__body {
    padding: 26px 26px 30px;
  }

  .milestone__when {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .milestone__year {
    font-family: var(--ff-display);
    font-style: italic;
    font-size: 34px;
    line-height: 1;
    color: var(--accent);
  }

  .milestone__month {
    font-family: var(--ff-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(26, 22, 20, 0.45);
  }

  .milestone__title {
    font-family: var(--ff-display);
    font-weight: 400;
    font-size: 24px;
    line-height: 1.2;
    margin: 14px 0 10px;
    color: var(--text-primary);
  }

  .milestone__text {
    font-size: 15px;
  }

  .journey__hint {
    font-family: var(--ff-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(26, 22, 20, 0.4);
    margin-top: 8px;
  }

  @media (max-width: 400px) {
    .milestone {
      min-width: 280px;
      max-width: 280px;
    }
  }
</style>
