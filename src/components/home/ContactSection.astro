---
/**
 * ContactSection — enquiry form plus direct contact details.
 *
 * The form POSTs to /api/contact, which does not exist until phase 9.
 * Until then a submission fails and the error state offers the mailto
 * fallback — deliberately, rather than faking success the way the
 * prototype did. A form that reports "Enquiry Sent" while sending
 * nothing is worse than one that plainly says it could not send.
 */
import { contact } from '../../data/site';
import OfficesBlock from './OfficesBlock.astro';
---

<section class="contact" id="contact">
  <div class="container contact__container">
    <div class="contact__grid">
      <div class="reveal">
        <span class="eyebrow">Get in Touch</span>
        <h2 class="section-h2 contact__title">Tell us about<br /><em>your project</em></h2>
        <p class="body-text contact__lead">
          Whether you're planning a new-build fit-out, a renovation, or sourcing FF&amp;E for a
          single property, our team is ready to help. We respond to all enquiries within one
          business day.
        </p>
        <div class="contact__details">
          <div class="contact__detail">
            <span class="contact__icon" aria-hidden="true">✆</span>
            <span class="contact__text">
              <strong>Phone</strong>
              <a href={contact.phonePrimary.href}>{contact.phonePrimary.label}</a>
              <span aria-hidden="true"> | </span>
              <a href={contact.phoneSecondary.href}>{contact.phoneSecondary.label}</a>
            </span>
          </div>
          <div class="contact__detail">
            <span class="contact__icon" aria-hidden="true">✉</span>
            <span class="contact__text">
              <strong>Email</strong>
              <a href={contact.email.href}>{contact.email.label}</a>
            </span>
          </div>
        </div>
      </div>

      <div class="reveal reveal-d2">
        <form class="form" id="contactForm" method="post" action="/api/contact" novalidate>
          <div class="form__row">
            <p class="form__group">
              <label class="form__label" for="fullname">
                Full Name <span class="form__req" aria-hidden="true">*</span>
              </label>
              <input class="form__input" type="text" id="fullname" name="fullname"
                autocomplete="name" placeholder="Sarah Johnson" required />
            </p>
            <p class="form__group">
              <label class="form__label" for="email">
                Email <span class="form__req" aria-hidden="true">*</span>
              </label>
              <input class="form__input" type="email" id="email" name="email"
                autocomplete="email" placeholder="sarah@hyatt.com" required />
            </p>
          </div>

          <div class="form__row">
            <p class="form__group form__group--full">
              <label class="form__label" for="message">
                About your project <span class="form__req" aria-hidden="true">*</span>
              </label>
              <textarea class="form__textarea" id="message" name="message"
                placeholder="Property name, location, scope, timeline…" required></textarea>
            </p>
          </div>

          <div class="form__divider"><span class="form__dividerLabel">Optional details</span></div>

          <div class="form__row">
            <p class="form__group">
              <label class="form__label" for="company">Company</label>
              <input class="form__input" type="text" id="company" name="company"
                autocomplete="organization" placeholder="Hyatt Hotels Corporation" />
            </p>
            <p class="form__group">
              <label class="form__label" for="jobtitle">Your Title</label>
              <input class="form__input" type="text" id="jobtitle" name="jobtitle"
                autocomplete="organization-title" placeholder="VP Development" />
            </p>
          </div>

          <div class="form__row">
            <p class="form__group">
              <label class="form__label" for="telephone">Phone</label>
              <input class="form__input" type="tel" id="telephone" name="telephone"
                autocomplete="tel" placeholder="+971 50 000 0000" />
            </p>
            <p class="form__group">
              <label class="form__label" for="country">Country</label>
              <input class="form__input" type="text" id="country" name="country"
                autocomplete="country-name" placeholder="United Arab Emirates" />
            </p>
          </div>

          {/* Honeypot — hidden from people, tempting to bots. */}
          <p class="form__hp" aria-hidden="true">
            <label for="website">Leave this field empty</label>
            <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
          </p>

          {/*
            Set by JS on load, not rendered server-side: this page is
            prerendered once at build time, so a value baked in here
            would be the same for every visitor regardless of when they
            actually opened the page. The server checks how much time
            elapsed since this value, as a bot-speed guard.
          */}
          <input type="hidden" name="loadedAt" value="" />

          <div class="form__submitRow">
            <p class="form__note">We respond within one business day.</p>
            <button type="submit" class="btn-primary form__submit">
              Send Enquiry <span class="btn-arrow" aria-hidden="true">→</span>
            </button>
          </div>

          <p class="form__status" id="formStatus" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>

    <OfficesBlock />
  </div>
</section>

<script>
  const form = document.getElementById('contactForm') as HTMLFormElement | null;
  const status = document.getElementById('formStatus');

  if (form && status) {
    const submit = form.querySelector<HTMLButtonElement>('.form__submit');
    const originalLabel = submit?.innerHTML ?? '';

    const loadedAtInput = form.querySelector<HTMLInputElement>('[name="loadedAt"]');
    if (loadedAtInput) loadedAtInput.value = String(Date.now());

    const setStatus = (message: string, kind: 'ok' | 'error' | '') => {
      status.textContent = message;
      status.dataset.kind = kind;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      // Use native validation messaging rather than inventing our own.
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      setStatus('', '');
      if (submit) {
        submit.disabled = true;
        submit.textContent = 'Sending…';
      }

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });

        if (!response.ok) throw new Error(`Request failed: ${response.status}`);

        form.reset();
        setStatus('Thank you — your enquiry has been sent. We reply within one business day.', 'ok');
      } catch {
        setStatus(
          'Sorry, your enquiry could not be sent. Please email info@ifield.ae or call +971 54 589 7890.',
          'error',
        );
      } finally {
        if (submit) {
          submit.disabled = false;
          submit.innerHTML = originalLabel;
        }
      }
    });
  }
</script>

<style>
  .contact {
    background: var(--bg-warm);
    padding: 120px 0;
    position: relative;
    overflow: hidden;
  }

  .contact::after {
    content: '';
    position: absolute;
    top: 0;
    right: -80px;
    width: 380px;
    height: 380px;
    background: url('/images/brand/element-01.webp') center / contain no-repeat;
    transform: scaleY(-1);
    opacity: 0.09;
    pointer-events: none;
  }

  .contact__container {
    position: relative;
    z-index: 1;
  }

  .contact__grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 80px;
    align-items: start;
  }

  .contact__title {
    line-height: 1.05;
    margin-bottom: 20px;
  }

  .contact__lead {
    margin-bottom: 36px;
  }

  .contact__details {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin-top: 8px;
  }

  .contact__detail {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  .contact__icon {
    width: 36px;
    height: 36px;
    background: var(--accent-light);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent);
    font-size: 15px;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .contact__text {
    font-family: var(--ff-body);
    font-size: var(--t-sm);
    font-weight: 300;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .contact__text strong {
    font-weight: 500;
    color: var(--text-primary);
    display: block;
    font-size: var(--t-eyebrow);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 2px;
  }

  .contact__text a:hover {
    color: var(--accent);
  }

  /* ── Form ── */
  .form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 16px;
  }

  .form__group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form__group--full {
    grid-column: span 2;
  }

  .form__label {
    font-family: var(--ff-body);
    font-size: var(--t-eyebrow);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .form__req {
    color: var(--accent);
  }

  .form__input,
  .form__textarea {
    width: 100%;
    padding: 14px 16px;
    background: var(--bg-cream);
    border: 1px solid var(--border-strong);
    border-radius: 2px;
    font-family: var(--ff-body);
    font-size: var(--t-sm);
    font-weight: 300;
    color: var(--text-primary);
    transition:
      border-color 0.2s,
      background 0.2s;
    outline: none;
  }

  .form__input:focus,
  .form__textarea:focus {
    border-color: var(--accent);
    background: #fff;
  }

  .form__input::placeholder,
  .form__textarea::placeholder {
    color: var(--text-muted);
    font-weight: 300;
  }

  .form__textarea {
    resize: vertical;
    min-height: 140px;
    line-height: 1.6;
  }

  .form__divider {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 4px 0 16px;
  }

  .form__divider::before,
  .form__divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  .form__dividerLabel {
    font-family: var(--ff-body);
    font-size: var(--t-eyebrow);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    white-space: nowrap;
  }

  /* Honeypot: removed from view and from assistive tech, but still
     submitted — bots that fill every field give themselves away. */
  .form__hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form__submitRow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 8px;
  }

  .form__note {
    font-family: var(--ff-body);
    font-size: 12px;
    color: var(--text-muted);
    font-weight: 300;
  }

  .form__submit[disabled] {
    opacity: 0.7;
    cursor: default;
  }

  .form__status {
    font-family: var(--ff-body);
    font-size: var(--t-sm);
    line-height: 1.6;
    margin-top: 16px;
  }

  .form__status[data-kind='ok'] {
    color: #2a6e3a;
  }

  .form__status[data-kind='error'] {
    color: var(--accent);
  }

  @media (max-width: 900px) {
    .contact__grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }

  @media (max-width: 600px) {
    .form__row {
      grid-template-columns: 1fr;
    }

    .form__group--full {
      grid-column: span 1;
    }
  }
</style>
