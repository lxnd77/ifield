---
/**
 * ProcessFlow — the homepage's six-stage horizontal rail.
 *
 * A glowing "comet" walks the rail, lighting each node in turn every
 * 1150ms and dragging an accent fill behind it, then resets and loops.
 * Below 1100px the rail, fill and comet are hidden and the steps become
 * a plain responsive grid — the horizontal metaphor stops working once
 * the nodes wrap.
 */
import { processSteps } from '../../data/process';
---

<section class="process" id="process">
  <div class="container process__container">
    <div class="process__header reveal">
      <span class="eyebrow">How We Work</span>
      <h2 class="section-h2">Our Process</h2>
      <span class="section-h2-sub section-h2-sub--accent">It's all in the details</span>
    </div>

    <div class="process__flow reveal reveal-d1" id="processFlow">
      <div class="process__line" aria-hidden="true"></div>
      <div class="process__fill" id="processFill" aria-hidden="true"></div>
      <div class="process__comet" id="processComet" aria-hidden="true"></div>

      <ol class="process__steps">
        {
          processSteps.map((step) => (
            <li class="process__step">
              <div class="process__node">{step.no}</div>
              <h3 class="process__stepTitle">{step.name}</h3>
              <p class="process__stepDesc">{step.desc}</p>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="process__more reveal">
      <a href="/process" class="link-viewall">See the full process →</a>
    </div>
  </div>
</section>

<script>
  const flow = document.getElementById('processFlow');
  const fill = document.getElementById('processFill');
  const comet = document.getElementById('processComet');

  if (flow && fill && comet) {
    const steps = Array.from(flow.querySelectorAll<HTMLElement>('.process__step'));
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

    /** Horizontal centre of a node, in px from the flow's left edge. */
    const nodeCentre = (index: number): number => {
      const node = steps[index]?.querySelector('.process__node');
      if (!node) return 0;
      const nodeRect = node.getBoundingClientRect();
      const flowRect = flow.getBoundingClientRect();
      return nodeRect.left + nodeRect.width / 2 - flowRect.left;
    };

    let current = -1;
    let timer: number | undefined;

    const reset = () => {
      steps.forEach((s) => s.classList.remove('is-active'));
      fill.style.width = '0px';
      comet.style.left = `${nodeCentre(0)}px`;
      current = -1;
    };

    const advance = () => {
      current += 1;

      // One extra beat with every node lit, then start over.
      if (current >= steps.length + 1) {
        reset();
        return;
      }
      if (current >= steps.length) return;

      steps.forEach((step, i) => step.classList.toggle('is-active', i <= current));

      const start = nodeCentre(0);
      const centre = nodeCentre(current);
      comet.style.left = `${centre}px`;
      fill.style.left = `${start}px`;
      fill.style.width = `${Math.max(0, centre - start)}px`;
    };

    const start = () => {
      if (timer !== undefined) return;
      flow.classList.add('is-running');
      advance();
      timer = window.setInterval(advance, 1150);
    };

    const stop = () => {
      window.clearInterval(timer);
      timer = undefined;
      flow.classList.remove('is-running');
    };

    /**
     * Reduced motion: light every stage at once and never animate. The
     * rail still reads as a sequence, it just does not move.
     */
    const applyReducedMotion = () => {
      if (reduced.matches) {
        stop();
        steps.forEach((s) => s.classList.add('is-active'));
        fill.style.width = '0px';
      } else {
        steps.forEach((s) => s.classList.remove('is-active'));
      }
    };

    reduced.addEventListener('change', applyReducedMotion);
    applyReducedMotion();

    if (!reduced.matches) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            // Pause off-screen: a timer running against an unseen section
            // burns battery and desynchronises the rail from the viewer.
            if (entry.isIntersecting) start();
            else stop();
          }
        },
        { threshold: 0.25 },
      );
      observer.observe(flow);

      // The comet is positioned in px from measured node centres, so a
      // font swap after load shifts the targets it was aimed at.
      if (document.fonts?.ready) {
        document.fonts.ready
          .then(() => {
            if (current >= 0 && current < steps.length) {
              const startX = nodeCentre(0);
              const centre = nodeCentre(current);
              comet.style.left = `${centre}px`;
              fill.style.left = `${startX}px`;
              fill.style.width = `${Math.max(0, centre - startX)}px`;
            }
          })
          .catch(() => {});
      }

      // The comet is positioned in px, so a resize invalidates it.
      let resizeTimer: number | undefined;
      window.addEventListener('resize', () => {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(() => {
          if (current >= 0 && current < steps.length) {
            const startX = nodeCentre(0);
            const centre = nodeCentre(current);
            comet.style.left = `${centre}px`;
            fill.style.left = `${startX}px`;
            fill.style.width = `${Math.max(0, centre - startX)}px`;
          }
        }, 150);
      });
    }
  }
</script>

<style>
  .process {
    background: var(--bg-cream);
    padding: 120px 0 130px;
    position: relative;
    overflow: hidden;
  }

  .process::before {
    content: '';
    position: absolute;
    bottom: -70px;
    right: -70px;
    width: 360px;
    height: 360px;
    background: url('/images/brand/element-03.webp') center / contain no-repeat;
    opacity: 0.12;
    pointer-events: none;
  }

  .process__container {
    position: relative;
    z-index: 1;
  }

  .process__header {
    text-align: center;
    margin-bottom: 76px;
  }

  .process__flow {
    position: relative;
    max-width: 1180px;
    margin: 0 auto;
  }

  .process__line,
  .process__fill {
    position: absolute;
    top: 37px;
    height: 2px;
  }

  .process__line {
    left: 6%;
    right: 6%;
    background: var(--border-strong);
  }

  .process__fill {
    left: 6%;
    width: 0;
    background: var(--accent);
    transition: width 0.7s var(--ease-out);
  }

  .process__comet {
    position: absolute;
    top: 37px;
    left: 6%;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.18);
    -webkit-backdrop-filter: blur(1.5px);
    backdrop-filter: blur(1.5px);
    border: 2px solid rgba(139, 26, 26, 0.85);
    box-shadow:
      0 0 14px 2px rgba(139, 26, 26, 0.45),
      inset 0 1px 5px rgba(255, 255, 255, 0.65);
    transform: translate(-50%, -50%);
    transition: left 0.7s var(--ease-out);
    opacity: 0;
    z-index: 6;
  }

  .process__flow.is-running .process__comet {
    opacity: 1;
  }

  .process__steps {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 26px;
    position: relative;
    z-index: 1;
    list-style: none;
  }

  .process__step {
    text-align: center;
  }

  .process__node {
    width: 74px;
    height: 74px;
    border-radius: 50%;
    border: 2px solid var(--border-strong);
    background: var(--bg-cream);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 26px;
    font-family: var(--ff-display);
    font-size: 26px;
    color: var(--text-muted);
    transition:
      border-color 0.45s var(--ease-out),
      background 0.45s var(--ease-out),
      color 0.45s var(--ease-out),
      transform 0.45s var(--ease-out),
      box-shadow 0.45s var(--ease-out);
    position: relative;
  }

  .process__step.is-active .process__node {
    border-color: var(--accent);
    background: var(--accent);
    color: #fff;
    transform: scale(1.06);
    box-shadow: 0 10px 26px rgba(139, 26, 26, 0.3);
  }

  .process__step.is-active .process__node::after {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: 50%;
    border: 2px solid var(--accent);
    animation: pRing 1.1s var(--ease-out) forwards;
  }

  @keyframes pRing {
    from {
      opacity: 0.55;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(1.55);
    }
  }

  .process__stepTitle {
    font-family: var(--ff-body);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-primary);
    margin-bottom: 12px;
    transition: color 0.3s;
  }

  .process__step.is-active .process__stepTitle {
    color: var(--accent);
  }

  .process__stepDesc {
    font-family: var(--ff-body);
    font-size: var(--t-sm);
    font-weight: 300;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  .process__more {
    text-align: center;
    margin-top: 64px;
  }

  @media (max-width: 1100px) {
    .process__steps {
      grid-template-columns: repeat(3, 1fr);
      gap: 52px 26px;
    }

    .process__line,
    .process__fill,
    .process__comet {
      display: none;
    }
  }

  @media (max-width: 680px) {
    .process__steps {
      grid-template-columns: 1fr 1fr;
      gap: 44px 20px;
    }
  }

  @media (max-width: 460px) {
    .process__steps {
      grid-template-columns: 1fr;
    }
  }
</style>
