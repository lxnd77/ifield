---
/**
 * ProjectsGrid — equal 3×2 grid of featured work.
 * Images dim on hover to reveal a circular arrow and "Know More".
 *
 * Reads the same CMS entries as the Projects page, so "featured work"
 * has one definition and each card links to its real case study. Takes
 * the first six by flagship order; the section hides itself entirely if
 * nothing is featured, rather than rendering an empty grid.
 */
import ImageSlot from '../ImageSlot.astro';
import type { ImageKey } from '../../data/images';
import { featuredProjectEntries } from '../../lib/projects';

const HOME_CARD_SLOTS: readonly ImageKey[] = [
  'homeProject01',
  'homeProject02',
  'homeProject03',
  'homeProject04',
  'homeProject05',
  'homeProject06',
];

const projects = (await featuredProjectEntries()).slice(0, 6);
---

{projects.length > 0 && (

<section class="projects" id="projects">
  <div class="container projects__container">
    <div class="section-header reveal">
      <div>
        <span class="eyebrow">Featured Work</span>
        <h2 class="section-h2 projects__title">
          Selected Projects &amp;<br /><em>Collaborations</em>
        </h2>
      </div>
      <a href="/projects" class="link-viewall">View All Projects →</a>
    </div>

    <div class="projects__grid">
      {
        projects.map((project, i) => (
          <a
            href={`/projects/${project.id}/`}
            class:list={['project', 'reveal', `reveal-d${i % 3}`]}
          >
            <div class="project__media">
              {project.data.cardImage ? (
                <img
                  class="project__img"
                  src={project.data.cardImage}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <ImageSlot slot={HOME_CARD_SLOTS[i % HOME_CARD_SLOTS.length]!} alt="" fill />
              )}
              <span class="project__hover" aria-hidden="true">
                <span class="project__arrow">→</span>
                <span class="project__know">Know More</span>
              </span>
            </div>
            <div class="project__info">
              <span class="project__brand">{project.data.title}</span>
              <div class="project__meta">
                <span class="project__location">{project.data.location}</span>
                {project.data.scope && (
                  <>
                    <span class="project__sep" aria-hidden="true">·</span>
                    <span class="project__scope">
                      {project.data.keys
                        ? `${project.data.keys} · ${project.data.scope}`
                        : project.data.scope}
                    </span>
                  </>
                )}
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
)}

<style>
  .projects {
    padding: 120px 0;
    background: var(--bg-warm);
    border-top: 1px solid var(--border);
    position: relative;
    overflow: hidden;
  }

  .projects::before {
    content: '';
    position: absolute;
    top: -40px;
    left: -40px;
    width: 320px;
    height: 320px;
    background: url('/images/brand/element-02.webp') center / contain no-repeat;
    opacity: 0.15;
    pointer-events: none;
  }

  .projects__container {
    position: relative;
    z-index: 1;
  }

  .projects__title {
    line-height: 1.05;
  }

  .projects__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px 24px;
  }

  .project {
    display: block;
    border-radius: 2px;
  }

  .project__media {
    overflow: hidden;
    position: relative;
    border-radius: 2px;
    height: 260px;
  }

  .project__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project__img,
  .project__media :global(img) {
    transition: transform 0.6s var(--ease-out);
  }

  .project:hover .project__img,
  .project:hover .project__media :global(img),
  .project:focus-visible .project__media :global(img) {
    transform: scale(1.05);
  }

  .project__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(8, 6, 4, 0);
    transition: background 0.4s;
    border-radius: 2px;
    pointer-events: none;
  }

  .project:hover .project__media::after,
  .project:focus-visible .project__media::after {
    background: rgba(8, 6, 4, 0.42);
  }

  .project__hover {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .project:hover .project__hover,
  .project:focus-visible .project__hover {
    opacity: 1;
  }

  .project__arrow {
    width: 42px;
    height: 42px;
    background: var(--accent);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 18px;
  }

  .project__know {
    font-family: var(--ff-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fff;
  }

  .project__info {
    padding: 16px 0 12px;
  }

  .project__brand {
    font-family: var(--ff-display);
    font-style: italic;
    font-size: 22px;
    font-weight: 400;
    color: var(--text-primary);
    margin-bottom: 6px;
    display: block;
  }

  .project__meta {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
  }

  .project__location {
    font-family: var(--ff-body);
    font-size: var(--t-xs);
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }

  .project__sep {
    font-family: var(--ff-body);
    font-size: var(--t-xs);
    color: var(--text-muted);
    margin: 0 8px;
  }

  .project__scope {
    font-family: var(--ff-body);
    font-size: var(--t-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }

  @media (max-width: 900px) {
    .projects__grid {
      grid-template-columns: 1fr 1fr;
      gap: 24px 16px;
    }
  }

  @media (max-width: 600px) {
    .projects__grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .project__media {
      height: 220px;
    }
  }
</style>
