---
/**
 * ServicesGrid — 4×2 dark grid of the eight capabilities.
 * Cards are grayscale at rest, colour on hover with the description
 * fading up. Each links to its row on /capabilities.
 */
import ImageSlot from '../ImageSlot.astro';
import { services } from '../../data/services';
---

<section class="services" id="services">
  <div class="container services__container">
    <div class="section-header">
      <div class="reveal">
        <span class="eyebrow">What We Do</span>
        <h2 class="section-h2 section-h2--light services__title">Our <em>Capabilities</em></h2>
      </div>
      <a href="/capabilities" class="link-viewall link-viewall--light reveal reveal-d2">
        All Capabilities →
      </a>
    </div>

    <div class="services__grid">
      {
        services.map((service, i) => (
          <a
            href={service.href}
            class:list={['service', 'reveal', `reveal-d${i % 4}`]}
            aria-label={`${service.name} — ${service.desc}`}
          >
            <ImageSlot
              slot={service.image}
              alt=""
              fill
              filter="grayscale(100%)"
              class="imgslot--on-dark"
            />
            <span class="service__overlay" aria-hidden="true" />
            <span class="service__content">
              <span class="service__name">{service.name}</span>
              <span class="service__desc">{service.desc}</span>
              <span class="service__arrow" aria-hidden="true">
                →
              </span>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services {
    background: var(--bg-dark);
    padding: 100px 0;
    position: relative;
    overflow: hidden;
  }

  /* Arch watermark, centred and bleeding off the bottom edge */
  .services::before {
    content: '';
    position: absolute;
    bottom: -80px;
    left: 50%;
    transform: translateX(-50%);
    width: 500px;
    height: 500px;
    background: url('/images/brand/element-01.webp') center / contain no-repeat;
    opacity: 0.04;
    pointer-events: none;
  }

  .services__container {
    position: relative;
    z-index: 1;
  }

  .services__title {
    line-height: 1.05;
  }

  .services__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 3px;
  }

  .service {
    position: relative;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    display: block;
  }

  .service :global(img) {
    transition:
      transform 0.7s var(--ease-out),
      filter 0.45s ease;
  }

  .service__overlay {
    position: absolute;
    inset: 0;
    background: rgba(10, 8, 6, 0.58);
    transition: background 0.45s ease;
  }

  .service:hover .service__overlay,
  .service:focus-visible .service__overlay {
    background: rgba(10, 8, 6, 0.08);
  }

  .service:hover,
  .service:focus-visible {
    --imgslot-filter: grayscale(0%);
  }

  .service:hover :global(img),
  .service:focus-visible :global(img) {
    transform: scale(1.06);
  }

  .service__content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 3;
    padding: 24px 22px 22px;
    background: linear-gradient(
      to top,
      rgba(8, 6, 4, 0.95) 0%,
      rgba(8, 6, 4, 0.8) 55%,
      transparent 100%
    );
    display: block;
  }

  .service__name {
    font-family: var(--ff-body);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
    margin-bottom: 8px;
    line-height: 1.3;
    min-height: 2.6em;
    display: flex;
    align-items: flex-end;
  }

  .service__desc {
    font-family: var(--ff-body);
    font-size: var(--t-xs);
    font-weight: 300;
    color: rgba(255, 255, 255, 0.82);
    line-height: 1.6;
    margin-bottom: 14px;
    display: block;
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.3s,
      transform 0.3s;
  }

  .service:hover .service__desc,
  .service:focus-visible .service__desc {
    opacity: 1;
    transform: translateY(0);
  }

  .service__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: var(--accent);
    border-radius: 50%;
    color: #fff;
    font-size: 14px;
    transition:
      background 0.2s,
      color 0.2s,
      transform 0.2s;
  }

  .service:hover .service__arrow,
  .service:focus-visible .service__arrow {
    background: #fff;
    color: var(--accent);
    transform: scale(1.1);
  }

  @media (max-width: 1000px) {
    .services__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .services__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
