---
/**
 * 404 — plain white page, same Nav/Footer as everywhere else.
 * No dark hero, so Nav is forced solid from the top.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" description="The page you're looking for doesn't exist." noindex solidNav>
  <section class="notfound">
    <div class="container notfound__inner">
      <span class="notfound__code">404</span>
      <h1 class="notfound__title">Page not found</h1>
      <p class="body-text notfound__text">
        The page you're looking for doesn't exist or may have moved.
      </p>
      <a href="/" class="btn-outline">
        Back to Home <span class="btn-arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    min-height: 100vh;
    display: flex;
    align-items: center;
    background: #fff;
  }

  .notfound__inner {
    padding-top: var(--nav-h);
    text-align: center;
    max-width: 560px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .notfound__code {
    font-family: var(--ff-display);
    font-weight: 400;
    font-size: clamp(64px, 10vw, 120px);
    line-height: 1;
    color: var(--accent);
  }

  .notfound__title {
    font-family: var(--ff-display);
    font-weight: 400;
    font-size: clamp(32px, 4.5vw, 48px);
    color: var(--text-primary);
    margin-top: 8px;
  }

  .notfound__text {
    margin-top: 16px;
    margin-bottom: 32px;
  }
</style>
