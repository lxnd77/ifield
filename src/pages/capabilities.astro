---
/**
 * Capabilities — the priority page.
 *
 * Hero · intro · eight alternating capability rows · "Why It Matters"
 * pillars · red closing band.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectionIntro from "../components/SectionIntro.astro";
import CapabilityRow from "../components/CapabilityRow.astro";
import DarkPillars from "../components/DarkPillars.astro";
import CtaBand from "../components/CtaBand.astro";
import { capabilities } from "../data/capabilities";

const pillars = [
  {
    title: "Consistent Finish",
    text: "With one team controlling every element, the whole interior comes together as a single, coherent result.",
  },
  {
    title: "No surprises",
    text: "Budget and schedule stay in our hands from the start, with no gaps opening up between trades.",
  },
  {
    title: "Specification integrity",
    text: "What is specified is what gets delivered, carried through cleanly from first sign-off to final handover.",
  },
];
---

<BaseLayout
  title="Fit-Out & FF&E Capabilities"
  description="Explore I-Field's eight in-house capabilities — from fit-out and joinery to lighting, textiles and artwork — delivered by one accountable hospitality team."
>
  <PageHero
    eyebrow="Capabilities"
    title="Transforming hospitality environments through <em>end-to-end</em> craft"
    lead="From the first drawing to the final accessory, every discipline a hotel needs is held under one roof: specified, manufactured and installed by Ifield's own teams."
    image="heroCapabilities"
    facts={[
      "Nothing Subcontracted",
      "In-House Manufacturing",
      "Turnkey Delivery",
    ]}
  />

  <SectionIntro
    eyebrow="What We Do"
    title="One partner for every element of the interior"
    subtitle="Fit-out and FF&E, fully integrated."
    paragraphs={[
      "Most hospitality projects are stitched together from a dozen specialist suppliers. We replace that complexity with a single, accountable team, managing fit-out, fixed and loose furniture, lighting, soft furnishings and accessories as one coordinated programme.",
      "We manufacture what we install, so lead times, quality and finish stay in our hands, not left to chance.",
    ]}
    flushBottom
  />

  <section class="caprows">
    <div class="container">
      <h2 class="visually-hidden">Our capabilities</h2>
      {
        capabilities.map((capability, i) => (
          <CapabilityRow capability={capability} flip={i % 2 === 1} />
        ))
      }
    </div>
  </section>

  <DarkPillars
    title="The difference <em>single-source</em> makes"
    intro="When one company holds every capability, the things that usually go wrong simply don't. Nothing is lost in the handovers between trades, timelines hold because every stage moves together, and there is always one team with the full picture, ready to answer any question."
    pillars={pillars}
  />

  <CtaBand
    title="Bring us your scope"
    subtitle="One brief, one team, one seamless delivery."
    actions={[
      { label: "Request a Consultation →", href: "/#contact" },
      { label: "View Our Projects", href: "/projects", ghost: true },
    ]}
  />
</BaseLayout>

<style>
  .caprows {
    background: var(--bg-cream);
    padding: 0 0 clamp(72px, 9vw, 112px);
  }

  /* The rows are <article>s under an <h3> each; this gives them a parent
     heading for screen readers without altering the visual design. */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
