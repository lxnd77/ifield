---
/**
 * Journal — hero · featured story · category chips · card grid ·
 * newsletter CTA.
 *
 * Category filtering follows the same pattern as /projects: synced to
 * `?category=`, applied client-side against a fully server-rendered
 * grid, degrading to "every post visible" without JavaScript.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import PostCard from "../components/journal/PostCard.astro";
import NewsletterForm from "../components/journal/NewsletterForm.astro";
import ImageSlot from "../components/ImageSlot.astro";
import {
  featuredPost,
  gridPosts,
  CATEGORY_LABELS,
  CATEGORY_ORDER,
  formatPostDateShort,
} from "../lib/posts";

const featured = await featuredPost();
const posts = await gridPosts();

const chips = [
  { key: "all" as const, label: "All" },
  ...CATEGORY_ORDER.map((c) => ({ key: c, label: CATEGORY_LABELS[c] })),
];

const featuredMeta = featured
  ? [
      CATEGORY_LABELS[featured.data.category],
      formatPostDateShort(featured.data.publishedAt),
      featured.data.readingTime,
    ]
      .filter(Boolean)
      .join(" · ")
  : "";
---

<BaseLayout
  title="Hospitality Design & FF&E Journal"
  description="Perspectives on FF&E procurement, hospitality design, and the craft of delivering luxury spaces."
>
  <PageHero
    eyebrow="The I-Field Journal"
    title="Insights & <em>industry thinking</em>"
    lead="Perspectives on FF&E procurement, hospitality design, and the craft of delivering luxury spaces — drawn from the field, across four continents."
    image="heroJournal"
    minHeight="66vh"
  />

  <!-- ── FEATURED STORY ── -->
  {
    featured && (
      <section class="jfeat">
        <div class="container">
          <div class="jfeat__head reveal">
            <span class="eyebrow">Featured Story</span>
            <h2 class="section-h2">
              Fresh from <em>the field</em>
            </h2>
          </div>

          <a href={`/journal/${featured.id}/`} class="jfeat__card reveal">
            <div class="jfeat__media">
              {featured.data.coverImage ? (
                <img
                  src={featured.data.coverImage}
                  alt=""
                  fetchpriority="high"
                  decoding="async"
                />
              ) : (
                <ImageSlot
                  slot="heroJournal"
                  alt=""
                  fill
                  filter="grayscale(28%) brightness(0.62)"
                />
              )}
              <span class="jfeat__tag">
                {CATEGORY_LABELS[featured.data.category]}
              </span>
            </div>
            <div class="jfeat__body">
              <span class="jfeat__meta">{featuredMeta}</span>
              <h3 class="jfeat__title">{featured.data.title}</h3>
              <p class="body-text jfeat__excerpt">{featured.data.excerpt}</p>
              <span class="jfeat__cta">
                Read the story <span aria-hidden="true">→</span>
              </span>
            </div>
          </a>
        </div>
      </section>
    )
  }

  <!-- ── ALL ARTICLES ── -->
  <section class="jall">
    <div class="container">
      <div class="jall__head reveal">
        <div>
          <span class="eyebrow">All Articles</span>
          <h2 class="section-h2">
            Everything we've <em>published</em>
          </h2>
        </div>
        <span class="jall__count" id="postCount">{posts.length} articles</span>
      </div>

      <nav class="jall__chips reveal" aria-label="Filter articles by category">
        {
          chips.map((chip) => (
            <a
              href={
                chip.key === "all"
                  ? "/journal/"
                  : `/journal/?category=${chip.key}`
              }
              class:list={["chip", { "is-active": chip.key === "all" }]}
              data-category={chip.key}
              aria-current={chip.key === "all" ? "true" : undefined}
            >
              {chip.label}
            </a>
          ))
        }
      </nav>

      <div class="jall__grid" id="postGrid">
        {
          posts.map((post, i) => (
            <div class="jall__item" data-category={post.data.category}>
              <PostCard post={post} index={i} />
            </div>
          ))
        }
      </div>

      {
        posts.length === 0 && (
          <p class="body-text jall__empty">
            No articles published yet — check back soon.
          </p>
        )
      }
    </div>
  </section>

  <!-- ── NEWSLETTER ── -->
  <section class="jnews">
    <div class="jnews__inner reveal">
      <span class="eyebrow eyebrow--light">Stay in the Loop</span>
      <h2 class="section-h2 section-h2--light">The field, in your inbox</h2>
      <span class="section-h2-sub jnews__sub">
        Occasional notes on procurement, design and delivery — no noise.
      </span>
      <NewsletterForm />
    </div>
  </section>
</BaseLayout>

<script>
  /**
   * Progressive enhancement, same approach as /projects: intercept the
   * chip links and filter in place, keeping the URL in sync. Without
   * JS the links still work as ordinary hrefs.
   */
  const chips = Array.from(
    document.querySelectorAll<HTMLAnchorElement>(".chip[data-category]"),
  );
  const items = Array.from(
    document.querySelectorAll<HTMLElement>(".jall__item[data-category]"),
  );
  const count = document.getElementById("postCount");

  if (chips.length > 0 && items.length > 0) {
    const apply = (category: string, pushState: boolean) => {
      let visible = 0;

      items.forEach((item) => {
        const show = category === "all" || item.dataset.category === category;
        item.hidden = !show;
        if (show) visible += 1;
      });

      chips.forEach((chip) => {
        const active = chip.dataset.category === category;
        chip.classList.toggle("is-active", active);
        if (active) chip.setAttribute("aria-current", "true");
        else chip.removeAttribute("aria-current");
      });

      if (count)
        count.textContent = `${visible} article${visible === 1 ? "" : "s"}`;

      if (pushState) {
        const url =
          category === "all" ? "/journal/" : `/journal/?category=${category}`;
        history.pushState({ category }, "", url);
      }
    };

    chips.forEach((chip) => {
      chip.addEventListener("click", (event) => {
        if (
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.button !== 0
        )
          return;
        event.preventDefault();
        apply(chip.dataset.category ?? "all", true);
      });
    });

    window.addEventListener("popstate", () => {
      const category =
        new URLSearchParams(location.search).get("category") ?? "all";
      apply(category, false);
    });

    const initial = new URLSearchParams(location.search).get("category");
    if (initial && chips.some((c) => c.dataset.category === initial))
      apply(initial, false);
  }
</script>

<style>
  /* ── Featured ── */
  .jfeat {
    background: var(--bg-cream);
    padding: clamp(72px, 10vw, 120px) 0 clamp(40px, 5vw, 56px);
  }

  .jfeat__head {
    margin-bottom: clamp(36px, 4.5vw, 56px);
  }

  .jfeat__card {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    align-items: stretch;
    gap: clamp(0px, 3vw, 52px);
  }

  .jfeat__media {
    position: relative;
    overflow: hidden;
    background-image: repeating-linear-gradient(
      135deg,
      #2a2622 0px,
      #2a2622 1px,
      #1f1b18 1px,
      #1f1b18 13px
    );
    aspect-ratio: 16 / 11;
    min-height: 340px;
  }

  .jfeat__media img,
  .jfeat__media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(28%) brightness(0.62);
  }

  .jfeat__tag {
    position: absolute;
    top: 22px;
    left: 22px;
    z-index: 1;
    font-family: var(--ff-body);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #fff;
    background: rgba(139, 26, 26, 0.92);
    padding: 8px 14px;
    border-radius: 2px;
  }

  .jfeat__body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(24px, 3vw, 20px) clamp(4px, 1vw, 8px);
  }

  .jfeat__meta {
    font-family: var(--ff-body);
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    margin-bottom: 16px;
  }

  .jfeat__title {
    font-family: var(--ff-display);
    font-weight: 400;
    font-size: clamp(30px, 3.4vw, 46px);
    line-height: 1.08;
    color: var(--text-primary);
  }

  .jfeat__excerpt {
    margin-top: 20px;
    max-width: 46ch;
  }

  .jfeat__cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 28px;
    font-family: var(--ff-body);
    font-size: var(--t-xs);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .jfeat__cta span {
    font-size: 16px;
    transition: transform 0.2s;
  }

  .jfeat__card:hover .jfeat__cta span {
    transform: translateX(4px);
  }

  /* ── All articles ── */
  .jall {
    background: var(--bg-cream);
    padding: clamp(40px, 5vw, 64px) 0 clamp(72px, 9vw, 116px);
  }

  .jall__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    margin-bottom: clamp(24px, 3vw, 36px);
  }

  .jall__count {
    font-family: var(--ff-body);
    font-size: 15px;
    font-weight: 300;
    letter-spacing: 0.04em;
    color: var(--text-secondary);
  }

  .jall__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: clamp(32px, 4vw, 48px);
    border-bottom: 1px solid var(--border);
    padding-bottom: 26px;
  }

  .jall__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(320px, 100%), 1fr));
    gap: clamp(18px, 2vw, 26px);
  }

  .jall__item[hidden] {
    display: none;
  }

  .jall__empty {
    text-align: center;
    padding: 40px 0;
  }

  /* ── Newsletter ── */
  .jnews {
    background: var(--accent);
    color: var(--on-dark);
    padding: clamp(72px, 10vw, 116px) clamp(24px, 5vw, 64px);
  }

  .jnews__inner {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }

  .jnews__sub {
    color: rgba(250, 248, 244, 0.85);
  }

  @media (max-width: 900px) {
    .jfeat__card {
      grid-template-columns: 1fr;
    }

    /*
     * No min-height here: combined with aspect-ratio, a min-height forces
     * a minimum width too (min-height × ratio) — 260px at 16:10 works out
     * to ~416px, wider than a 320–375px viewport, and overflows. The
     * aspect-ratio alone is enough once the column is full-width.
     */
    .jfeat__media {
      aspect-ratio: 16 / 10;
      min-height: 0;
    }
  }
</style>
