---
/**
 * Journal article — designed from the existing system, since the
 * bundle contained no article template.
 *
 * Hero · reading-progress bar · prose body · tags & share · related ·
 * newsletter CTA.
 */
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImageSlot from '../../components/ImageSlot.astro';
import PostCard from '../../components/journal/PostCard.astro';
import NewsletterForm from '../../components/journal/NewsletterForm.astro';
import {
  allPosts,
  relatedPosts,
  CATEGORY_LABELS,
  formatPostDate,
} from '../../lib/posts';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const posts = await allPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: Awaited<ReturnType<typeof allPosts>>[number];
}

const { post } = Astro.props;
const { data } = post;

const { Content } = await render(post);
const related = await relatedPosts(post, 3);

const metaParts = [
  CATEGORY_LABELS[data.category],
  formatPostDate(data.publishedAt),
  data.readingTime,
].filter(Boolean);

const shareUrl = new URL(`/journal/${post.id}/`, Astro.site ?? 'https://www.ifield.ae').href;
const shareText = data.title;
---

<BaseLayout title={data.title} description={data.excerpt}>
  <!-- ── READING PROGRESS ── -->
  <div class="rprogress" aria-hidden="true">
    <div class="rprogress__bar" id="readingProgress"></div>
  </div>

  <!-- ── HERO ── -->
  <section class="ahero">
    <div class="ahero__media">
      {
        data.coverImage ? (
          <img src={data.coverImage} alt="" fetchpriority="high" decoding="async" />
        ) : (
          <ImageSlot slot="heroJournal" fill class="imgslot--on-dark" />
        )
      }
    </div>
    <div class="ahero__scrim" aria-hidden="true"></div>

    <div class="container ahero__inner">
      <p class="ahero__eyebrow">{CATEGORY_LABELS[data.category]}</p>
      <h1 class="ahero__title">{data.title}</h1>
      <p class="ahero__meta">{metaParts.join(' · ')}</p>
      {
        data.author.name && (
          <p class="ahero__author">
            {data.author.name}
            {data.author.role && <span class="ahero__authorRole"> — {data.author.role}</span>}
          </p>
        )
      }
    </div>
  </section>

  <!-- ── ARTICLE BODY ── -->
  <article class="abody">
    <div class="container">
      <div class="prose">
        <p class="lead">{data.excerpt}</p>
        <Content />
      </div>

      <!-- ── TAGS + SHARE ── -->
      <div class="ameta">
        <span class="chip ameta__tag" aria-hidden="true">{CATEGORY_LABELS[data.category]}</span>
        <div class="ameta__share">
          <span class="ameta__shareLabel">Share</span>
          <a
            class="social-link"
            aria-label="Share on LinkedIn"
            href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            in
          </a>
          <a
            class="social-link"
            aria-label="Share on X"
            href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(shareUrl)}&text=${encodeURIComponent(shareText)}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            X
          </a>
          <a
            class="social-link"
            aria-label="Share by email"
            href={`mailto:?subject=${encodeURIComponent(shareText)}&body=${encodeURIComponent(shareUrl)}`}
          >
            ✉
          </a>
        </div>
      </div>
    </div>
  </article>

  <!-- ── RELATED ── -->
  {
    related.length > 0 && (
      <section class="arelated">
        <div class="container">
          <div class="arelated__head reveal">
            <span class="eyebrow">Keep Reading</span>
            <h2 class="section-h2">
              More from the <em>Journal</em>
            </h2>
          </div>
          <div class="arelated__grid">
            {related.map((p, i) => (
              <PostCard post={p} index={i} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- ── NEWSLETTER ── -->
  <section class="jnews">
    <div class="jnews__inner reveal">
      <span class="eyebrow eyebrow--light">Stay in the Loop</span>
      <h2 class="section-h2 section-h2--light">The field, in your inbox</h2>
      <span class="section-h2-sub jnews__sub">
        Occasional notes on procurement, design and delivery — no noise.
      </span>
      <NewsletterForm />
    </div>
  </section>
</BaseLayout>

<script>
  /**
   * Tracks scroll progress through the article body specifically — not
   * the whole document. 0% while the article's top has not yet reached
   * the top of the viewport (still in the hero), 100% once the article's
   * bottom has scrolled up to the bottom of the viewport (finished
   * reading) — not somewhere in the middle of the related-posts shelf.
   */
  const bar = document.getElementById('readingProgress');
  const article = document.querySelector<HTMLElement>('.abody');

  if (bar && article) {
    let ticking = false;

    const update = () => {
      ticking = false;
      const rect = article.getBoundingClientRect();
      const articleAbsTop = rect.top + window.scrollY;
      const articleHeight = article.offsetHeight;
      const viewportH = window.innerHeight;

      // Denominator is how far the viewport travels between "article top
      // at viewport top" and "article bottom at viewport bottom". Floored
      // at 1 so a short article (shorter than the viewport) still reaches
      // 100% rather than dividing by a negative number.
      const denom = Math.max(1, articleHeight - viewportH);
      const pct = Math.min(100, Math.max(0, ((window.scrollY - articleAbsTop) / denom) * 100));

      bar.style.width = `${pct}%`;
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  }
</script>

<style>
  /* ── Reading progress ── */
  .rprogress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    z-index: 150;
    background: transparent;
  }

  .rprogress__bar {
    height: 100%;
    width: 0%;
    background: var(--accent);
    transition: width 0.1s linear;
  }

  /* ── Hero ── */
  .ahero {
    position: relative;
    min-height: 58vh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    background: var(--bg-dark);
    overflow: hidden;
    padding: 148px 0 72px;
  }

  .ahero__media {
    position: absolute;
    inset: 0;
  }

  .ahero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(28%) brightness(0.5);
  }

  .ahero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(17, 16, 9, 0.55) 0%,
      rgba(17, 16, 9, 0.25) 40%,
      rgba(17, 16, 9, 0.92) 100%
    );
  }

  .ahero__inner {
    position: relative;
    z-index: 2;
    width: 100%;
  }

  .ahero__eyebrow {
    font-family: var(--ff-body);
    font-size: var(--t-eyebrow);
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
    background: rgba(139, 26, 26, 0.14);
    display: inline-block;
    padding: 6px 12px;
    border-radius: 2px;
    margin-bottom: 22px;
  }

  .ahero__title {
    font-family: var(--ff-display);
    font-weight: 400;
    font-size: clamp(34px, 4.6vw, 64px);
    line-height: 1.08;
    color: #fff;
    max-width: 20ch;
  }

  .ahero__meta {
    font-family: var(--ff-body);
    font-size: var(--t-sm);
    font-weight: 300;
    color: rgba(255, 255, 255, 0.6);
    margin-top: 20px;
  }

  .ahero__author {
    font-family: var(--ff-body);
    font-size: var(--t-sm);
    font-weight: 500;
    color: rgba(255, 255, 255, 0.85);
    margin-top: 6px;
  }

  .ahero__authorRole {
    font-weight: 300;
    color: rgba(255, 255, 255, 0.55);
  }

  /* ── Body ── */
  .abody {
    background: var(--bg-cream);
    padding: clamp(56px, 8vw, 96px) 0 clamp(48px, 6vw, 72px);
  }

  .abody .prose .lead {
    color: var(--text-primary);
  }

  /* ── Tags + share ── */
  .ameta {
    max-width: var(--measure);
    margin: clamp(48px, 6vw, 72px) auto 0;
    padding-top: 28px;
    border-top: 1px solid var(--border);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
  }

  .ameta__tag {
    cursor: default;
  }

  .ameta__tag:hover {
    border-color: var(--border-strong);
    color: var(--text-secondary);
  }

  .ameta__share {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .ameta__shareLabel {
    font-family: var(--ff-body);
    font-size: var(--t-xs);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-right: 4px;
  }

  /* Reuse the footer's circular social-link treatment, on a light ground */
  .ameta .social-link {
    border-color: var(--border-strong);
    color: var(--text-secondary);
  }

  .ameta .social-link:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* ── Related ── */
  .arelated {
    background: var(--bg-warm);
    padding: clamp(64px, 8vw, 100px) 0;
    border-top: 1px solid var(--border);
  }

  .arelated__head {
    margin-bottom: clamp(32px, 4vw, 48px);
  }

  .arelated__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: clamp(18px, 2vw, 26px);
  }

  /* ── Newsletter ── */
  .jnews {
    background: var(--accent);
    color: var(--on-dark);
    padding: clamp(72px, 10vw, 116px) clamp(24px, 5vw, 64px);
  }

  .jnews__inner {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }

  .jnews__sub {
    color: rgba(250, 248, 244, 0.85);
  }
</style>
