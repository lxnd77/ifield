---
/**
 * The Company — hero · story · stats · journey · vision & mission ·
 * approach · founder · team · closing band.
 *
 * `#approach` and `#team` anchors are linked from the footer.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectionIntro from "../components/SectionIntro.astro";
import StatBand from "../components/StatBand.astro";
import ImageSlot from "../components/ImageSlot.astro";
import JourneyTimeline from "../components/company/JourneyTimeline.astro";
import TeamGrid from "../components/company/TeamGrid.astro";
import CtaBand from "../components/CtaBand.astro";
---

<BaseLayout
  title="About I-Field — Hospitality Fit-Out & FF&E Since 2003"
  description="Founded in Hong Kong in 2003, I-Field is a turnkey fit-out and FF&E company built by hospitality people, now operating from nine offices worldwide."
>
  <PageHero
    eyebrow="The Company"
    title="Crafting the <em>epitome</em> of luxury hospitality"
    lead="An end-to-end fit-out and FF&E partner, delivering every project from first specification to final handover."
    image="heroCompany"
    facts={[
      "Est. 2003 · Hong Kong",
      "20+ Countries",
      "9 Global Offices",
      "Luxury Hospitality",
    ]}
    minHeight="80vh"
    titleWidth="14ch"
  />

  <SectionIntro
    eyebrow="Our Story"
    title="The Partner Behind the Finish"
    subtitle="Turnkey solutions since 2003."
    paragraphs={[
      "For over two decades, I-Field has done one thing: deliver the interiors that define exceptional hospitality. What began with a vision has become a global fit-out and FF&E group, entrusted by the owners and developers behind some of the world's most acclaimed properties.",
      "We work alongside the architects and designers shaping these spaces, giving form to their ideas through skilled craftsmanship and precise manufacturing. Every project is different; the standard never is. From first specification to final handover, we control each stage ourselves, so nothing is lost between the drawing and the finished room.",
    ]}
    flushBottom
  />

  <section class="storyImage">
    <div class="container">
      <div class="storyImage__frame reveal">
        <ImageSlot slot="companyStory" fill filter="grayscale(18%)" />
      </div>
    </div>
  </section>

  <StatBand variant="dark" />

  <JourneyTimeline />

  <!-- ── VISION & MISSION ── -->
  <section class="vm">
    <div class="container">
      <div class="vm__grid">
        <div class="reveal">
          <span class="eyebrow">Our Vision</span>
          <h2 class="vm__statement">
            To be the most trusted name in luxury hospitality fit-out and
            FF&amp;E.
          </h2>
          <p class="body-text vm__copy">
            A future where the most demanding projects, anywhere in the world,
            are placed in our hands with complete confidence.
          </p>
        </div>
        <div class="reveal reveal-d2">
          <span class="eyebrow">Our Mission</span>
          <h2 class="vm__statement">
            Nothing lost, from first drawing to final handover.
          </h2>
          <p class="body-text vm__copy">
            Every stage stays in our hands, from manufacture and supply through
            to final fit-out, with no gaps and no handoffs along the way.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── OUR APPROACH ── -->
  <section class="split" id="approach">
    <div class="container">
      <div class="split__grid">
        <div class="split__media reveal">
          <ImageSlot slot="companyApproach" fill filter="grayscale(18%)" />
        </div>
        <div class="reveal reveal-d1">
          <span class="eyebrow">Our Approach</span>
          <h2 class="section-h2">No Two Projects Alike</h2>
          <p class="body-text split__copy">
            We work as an extension of the owners and operators we partner with,
            bringing the technology, craft and resources to realise spaces
            unlike any other. Every decision is made to serve both the guest
            experience and the value of the asset.
          </p>
          <p class="body-text split__copy">
            Every project takes its cue from the brand behind it and the setting
            around it: highly individual spaces and furnishings that give form
            to each operator's identity and standards.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── FOUNDER ── -->
  <section class="split split--warm">
    <div class="container">
      <div class="split__grid split__grid--founder">
        <div class="split__media split__media--portrait reveal">
          <ImageSlot slot="companyFounder" fill filter="grayscale(18%)" />
        </div>
        <div class="reveal reveal-d1">
          <span class="eyebrow">Our Founder</span>
          <h2 class="section-h2">Trusted, personally</h2>
          <p class="body-text split__copy">
            In 2003, Abhay moved from India to China and set about building
            Ifield from the ground up. Drawing on hard-won skills, knowledge and
            network, he established it as one of the region's leading turnkey
            FF&E manufacturers, later investing in a dedicated furniture factory
            and establishing Guangzhou Daka Import & Export to make the company
            fully self-reliant.
          </p>
          <p class="body-text split__copy">
            He pairs a deep command of FF&E with a rare understanding of people.
            He invests in local talent and training wherever Ifield operates,
            and attends to every client and project himself. That reputation,
            built one relationship at a time, is why clients return to Ifield,
            and why the company now works across more than 20 countries.
          </p>
          <p class="founder__sig">
            Abhay Bhargava<span class="founder__role"
              >— Founder &amp; Managing Director</span
            >
          </p>
        </div>
      </div>
    </div>
  </section>

  <TeamGrid />

  <CtaBand
    title="Tell us about your project"
    subtitle="Let's build something enduring, together."
    actions={[
      { label: "Request a Consultation →", href: "/#contact" },
      { label: "View Our Projects", href: "/projects", ghost: true },
    ]}
  />
</BaseLayout>

<style>
  /* ── Wide story image ── */
  .storyImage {
    background: var(--bg-cream);
    padding: 0 0 clamp(72px, 10vw, 120px);
  }

  .storyImage__frame {
    position: relative;
    height: clamp(300px, 42vw, 500px);
    overflow: hidden;
    border: 1px solid rgba(26, 22, 20, 0.08);
  }

  /* ── Vision & Mission ── */
  .vm {
    background: var(--bg-dark);
    color: var(--on-dark);
    padding: clamp(72px, 10vw, 116px) 0;
  }

  .vm__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: clamp(48px, 6vw, 96px);
  }

  .vm__statement {
    font-family: var(--ff-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(26px, 3vw, 40px);
    line-height: 1.3;
    color: var(--on-dark);
  }

  .vm__copy {
    color: var(--on-dark-muted);
    margin-top: 24px;
  }

  /* ── Approach / Founder split ── */
  .split {
    background: var(--bg-cream);
    padding: clamp(72px, 10vw, 120px) 0;
    scroll-margin-top: var(--nav-h);
  }

  .split--warm {
    background: var(--bg-warm);
  }

  .split__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(330px, 100%), 1fr));
    gap: clamp(40px, 6vw, 80px);
    align-items: center;
  }

  .split__grid--founder {
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: clamp(40px, 6vw, 84px);
  }

  .split__media {
    position: relative;
    height: clamp(340px, 40vw, 540px);
    overflow: hidden;
    border: 1px solid rgba(26, 22, 20, 0.08);
  }

  .split__media--portrait {
    height: auto;
    aspect-ratio: 4 / 5;
  }

  .split__copy {
    margin-top: 24px;
  }

  .founder__sig {
    font-family: var(--ff-display);
    font-style: italic;
    font-size: clamp(20px, 1.8vw, 24px);
    color: var(--accent);
    margin-top: 30px;
  }

  .founder__role {
    font-family: var(--ff-body);
    font-style: normal;
    font-size: var(--t-eyebrow);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(26, 22, 20, 0.5);
    margin-left: 12px;
  }
</style>
